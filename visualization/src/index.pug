doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title aw-watcher-input visualization
    style
      | :root {
      |   --bg: #ffffff;
      |   --text: #000000;
      |   --status: #000000;
      | }
      | html[data-theme="dark"] {
      |   --bg: #1a1d24;
      |   --text: #e4e9f2;
      |   --status: #a5b4cc;
      | }
      | th { text-align: left; }
      | body { font-family: sans-serif; background: var(--bg); color: var(--text); }
      | #status { color: var(--status); }
      | body { margin: 4px; font-size: 12px; display: flex; flex-direction: column; height: calc(100vh - 8px); }
      | #chart-container { position: relative; flex: 1; min-height: 0; max-height: 240px; }
      | #status { margin: 0 0 4px; }
      | #status:empty { display: none; }
      | table { flex: none; margin-top: 4px; width: 100%; border-collapse: collapse; line-height: 14px; }
      | th, td { padding: 0; }
      | td { text-align: right; }
  body
    p#status(role="status") Loading input activity…
    div#chart-container
      canvas#input-chart(role="img" aria-label="Keyboard presses and mouse clicks per time interval")
    table(aria-label="Input totals for the selected range")
      tr
        th(scope="row") Presses
        td#presses —
      tr
        th(scope="row") Clicks
        td#clicks —
    script(src="bundle.js")
