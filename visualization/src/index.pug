html
  head
    title aw-watcher-input visualization
    style
      | th { text-align: left; }
      | body { font-family: sans-serif; }
      | #chart-container { position: relative; height: 300px; margin-top: 1em; }
  body
    p#status

    table
      tr
        th Keyboard
      tr
        td Presses
        td#presses
      tr
        td &nbsp;
      tr
        th Mouse
      tr
        td Clicks
        td#clicks

    #chart-container
      canvas#chart

    script(src="bundle.js")
